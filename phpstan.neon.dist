# ==================================================
# PHPStan configuration for the Gorres Blocks project
# Author: Jörn Gorres
# Level 6, WordPress stubs via szepeviktor/phpstan-wordpress.
# Analysed against PHP 8.1 (minimum version from the plugin header).
# ==================================================

includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	phpVersion: 80100

	paths:
		- plugin

	# Optional paths marked with (?) because they do not always exist
	excludePaths:
		- plugin/languages (?)
		- plugin/build (?)
		- plugin/node_modules (?)

	# Additional stubs (directory may be empty)
	scanDirectories:
		- stubs

	# Constants the plugin defines at runtime
	bootstrapFiles:
		- phpstan-bootstrap.php

	# Avoids false positives with WordPress return types
	treatPhpDocTypesAsCertain: false

	# Ignored patterns may stay without a match
	reportUnmatchedIgnoredErrors: false

	ignoreErrors:
		# Tolerate arrays without value type on level 6 (typical for WordPress)
		- identifier: missingType.iterableValue
		# Add project specific exceptions with a reason here.
