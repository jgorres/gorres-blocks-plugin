{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gorres-blocks/hero-teaser",
	"version": "1.2.0",
	"title": "Hero Teaser",
	"category": "media",
	"icon": "cover-image",
	"description": "A screen-high image with a teaser box on top. The box scrolls away first, then the image follows and the post comes up.",
	"keywords": [ "hero", "teaser", "sticky", "scroll", "cover" ],
	"textdomain": "gorres-blocks",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true,
			"__experimentalSkipSerialization": [ "padding" ]
		},
		"shadow": {
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true
		}
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"mediaId": {
			"type": "number",
			"default": 0
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"focalPoint": {
			"type": "object"
		},
		"dim": {
			"type": "number",
			"default": 20
		},
		"boxStart": {
			"type": "number",
			"default": 50
		},
		"boxAlign": {
			"type": "string",
			"enum": [ "left", "center", "right" ],
			"default": "left"
		},
		"boxWidth": {
			"type": "number",
			"default": 40
		},
		"topOffset": {
			"type": "number",
			"default": 0
		}
	},
	"example": {
		"attributes": {
			"boxStart": 30
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"content": "A headline that makes people read on"
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Two or three sentences that tell what the post is about."
				}
			}
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
