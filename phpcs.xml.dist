<?xml version="1.0"?>
<ruleset name="Gorres Blocks"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

	<description>WordPress Coding Standards for the Gorres Blocks plugin (prefix jgor_gblk_).</description>

	<!-- Directories to check -->
	<file>plugin</file>

	<!-- Exclusions -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/stubs/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Runtime options: PHP only, show sniff codes, progress, colors, parallel, cache -->
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>

	<!-- Target versions from the plugin header: PHP 8.1, WordPress 6.8 -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_supported_wp_version" value="6.8"/>

	<!-- Full WordPress standard (Core, Docs, Extra) -->
	<rule ref="WordPress"/>

	<!-- PHP compatibility from testVersion upwards -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Prefix check: every global function, class, constant, hook, option and
	     transient must start with jgor (in this plugin: jgor_gblk_, JGOR_GBLK_, jgor-gblk-). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="jgor"/>
			</property>
		</properties>
	</rule>

	<!-- Text domain check: plugin slug -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gorres-blocks"/>
			</property>
		</properties>
	</rule>

</ruleset>
